{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cargo-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    { "pattern": "raahiinternational.com", "custom_domain": true },
    { "pattern": "www.raahiinternational.com", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://raahiinternational.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Images binding: required by OpenNext for /_next/image resizing + AVIF/WebP.
  // Without it the worker returns the original file unoptimized.
  "images": {
    "binding": "IMAGES"
  },
  // Writable page cache + revalidation tags (open-next.config.ts) for instant Sanity publishing
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "6974e1d749574091bd874eaf16e217eb" }
  ],
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "cargo-app-tag-cache", "database_id": "960ca13c-fb12-4efb-b73a-deb5462b6fbb" }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "cargo-app" }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1000",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  },
  // Staging: separate Worker (cargo-app-staging) on workers.dev only, no custom domains.
  // Deploy with: npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy --env staging
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://raahiinternational.com"
      },
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        { "binding": "NEXT_INC_CACHE_KV", "id": "89e55ed571a548a8b027adf472a1e18b" }
      ],
      "d1_databases": [
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "cargo-app-staging-tag-cache", "database_id": "16039ed0-64e7-40d6-8c45-3057de44b020" }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "cargo-app-staging" }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1000",
            "simple": {
              "limit": 10,
              "period": 60
            }
          }
        ]
      }
    }
  }
}
